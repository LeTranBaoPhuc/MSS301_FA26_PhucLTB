{
	"info": {
		"name": "MSS301 - Saga Demo (Spring Boot 4.1.1)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "orderUrl", "value": "http://localhost:8081" },
		{ "key": "inventoryUrl", "value": "http://localhost:8082" },
		{ "key": "paymentUrl", "value": "http://localhost:8083" },
		{ "key": "kb1OrderId", "value": "" },
		{ "key": "kb2OrderId", "value": "" },
		{ "key": "kb3OrderId", "value": "" },
		{ "key": "kb4OrderId", "value": "" },
		{ "key": "kb5OrderId", "value": "" }
	],
	"item": [
		{
			"name": "0 - Kiểm tra service",
			"item": [
				{
					"name": "Kiểm tra inventory-service",
					"request": {
						"method": "GET",
						"url": "{{inventoryUrl}}/api/inventory/products"
					},
					"event": [{
						"listen": "test",
						"script": { "exec": [ "pm.test('HTTP 200', () => pm.response.to.have.status(200));" ] }
					}]
				},
				{
					"name": "Kiểm tra payment-service",
					"request": {
						"method": "GET",
						"url": "{{paymentUrl}}/api/payments/wallets"
					},
					"event": [{
						"listen": "test",
						"script": { "exec": [ "pm.test('HTTP 200', () => pm.response.to.have.status(200));" ] }
					}]
				},
				{
					"name": "Kiểm tra order-service",
					"request": {
						"method": "GET",
						"url": "{{orderUrl}}/api/orders"
					},
					"event": [{
						"listen": "test",
						"script": { "exec": [ "pm.test('HTTP 200', () => pm.response.to.have.status(200));" ] }
					}]
				}
			]
		},
		{
			"name": "KB1 - Happy path",
			"item": [
				{
					"name": "[KB1] 1. Snapshot kho & ví",
					"request": {
						"method": "GET",
						"url": "{{inventoryUrl}}/api/inventory/products"
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
								"pm.response.json().forEach(p => pm.collectionVariables.set('stock_' + p.id, p.stock));",
								"pm.sendRequest(pm.collectionVariables.get('paymentUrl') + '/api/payments/wallets', (err, res) => {",
								"    pm.test('Đọc được số dư ví', () => pm.expect(err).to.be.null);",
								"    res.json().forEach(w => pm.collectionVariables.set('bal_' + w.customerId, w.balance));",
								"});"
							]
						}
					}]
				},
				{
					"name": "[KB1] 2. Đặt hàng",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{orderUrl}}/api/orders",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"C1\",\n  \"productId\": \"P1\",\n  \"quantity\": 2,\n  \"amount\": 2000\n}"
						}
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
								"const o = pm.response.json();",
								"pm.collectionVariables.set('kb1OrderId', o.id);",
								"pm.test('Order status = CONFIRMED', () => pm.expect(o.status).to.eql('CONFIRMED'));",
								"pm.test('Saga status = COMPLETED', () => pm.expect(o.sagaStatus).to.eql('COMPLETED'));",
								"pm.test('Không có failureReason', () => pm.expect(o.failureReason).to.be.null);"
							]
						}
					}]
				},
				{
					"name": "[KB1] 3. Kiểm tra kho & ví",
					"request": {
						"method": "GET",
						"url": "{{inventoryUrl}}/api/inventory/products"
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"const expectStock = { 'P1': -2 };",
								"const expectBal = { 'C1': -2000 };",
								"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
								"pm.response.json().forEach(p => {",
								"    if (p.id in expectStock) {",
								"        const before = Number(pm.collectionVariables.get('stock_' + p.id));",
								"        pm.test(`Tồn kho ${p.id}: ${before} -> ${before + expectStock[p.id]}`,",
								"            () => pm.expect(p.stock).to.eql(before + expectStock[p.id]));",
								"    }",
								"});",
								"pm.sendRequest(pm.collectionVariables.get('paymentUrl') + '/api/payments/wallets', (err, res) => {",
								"    res.json().forEach(w => {",
								"        if (w.customerId in expectBal) {",
								"            const before = Number(pm.collectionVariables.get('bal_' + w.customerId));",
								"            pm.test(`Số dư ${w.customerId}: ${before} -> ${before + expectBal[w.customerId]}`,",
								"                () => pm.expect(w.balance).to.eql(before + expectBal[w.customerId]));",
								"        }",
								"    });",
								"});"
							]
						}
					}]
				},
				{
					"name": "[KB1] 4. Saga logs",
					"request": {
						"method": "GET",
						"url": "{{orderUrl}}/api/orders/{{kb1OrderId}}/saga-logs"
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
								"const steps = pm.response.json().map(l => l.step);",
								"pm.test('Thứ tự bước Saga đúng', () => pm.expect(steps).to.eql([",
								"    'CREATE_ORDER', 'RESERVE_INVENTORY', 'PROCESS_PAYMENT', 'CONFIRM_ORDER'",
								"]));"
							]
						}
					}]
				}
			]
		},
